# Copy to .env. Exported variables win over .env, which wins over engines/<engine>/defaults.env.
# ENGINE=vllm
# PORT=8000
# MODEL_DIR=$HOME/models/Inkling-2-Mini
# MAX_SEQS=32            # the admission cap: user 33 queues instead of slowing everyone below the floor
# GPU_UTIL=0.70          # vLLM / TokenSpeed: share of the 121 GiB unified pool
# MEM_FRACTION=0.45      # SGLang: static pool share
# RESTART=unless-stopped # for a standing deployment
# VLLM_API_KEY=...       # vLLM: require a bearer key (exported into the container by EXTRA_ARGS=--api-key ...)
