# Recipe-wide defaults. Override in .env or by exporting a variable.
PORT=8000
HOST=0.0.0.0
SERVED_NAME=inkling-2-mini
MODEL_DIR=$HOME/models/Inkling-2-Mini
MODEL_REVISION=ed40e7da625f594fc9c4990f5f66be24873c22d7
CONTAINER=inkling2mini
# Persistent JIT / autotune / graph caches: later starts skip compilation.
CACHE_DIR=$HOME/.cache/inkling2mini-spark
WAIT_TIMEOUT=2400
MIN_AVAIL_GIB=40
# Docker restart policy: "no" while experimenting, "unless-stopped" for a standing deployment.
RESTART=no
