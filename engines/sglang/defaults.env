# SGLang: starts from the cookbook's verified DGX Spark DSpark recipe, tuned for concurrency (docs/RESULTS.md).
IMAGE=lmsysorg/sglang:inkling-2-mini
PORT=8000
CONTEXT=262144
MAX_SEQS=32
MEM_FRACTION=0.65
CHUNK=8192
KV=auto
SPEC=dspark
SPEC_DRAFT_TOKENS=8
MAX_JOBS=4
EXTRA_ARGS=
# knapcio's overlays: +16-21 % aggregate at 16-24 users, cold prefill ~6,100 tok/s (stock ~3,700); OVERLAY=0 = stock
OVERLAY=1
OVERLAY_COMMIT=5b42d3f52d9a0f4fbcb24f09e56c3268e17eb559
