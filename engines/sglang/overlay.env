# knapcio v2.4 overlay switches (launch.sh defaults; KV12 side pool 1024 pages = one 128K request)
INKLING_VERIFY_CAP=policy:/opt/inkling-overlay/inkling_vcap/policies/r2-theta004.json,bsmax=16
INKLING_VERIFY_CAP_LOG_EVERY=0
INKLING_DRAFT_BYTES=gemv,fold8,head8,draftmx8,hotvocab:65536,wide8,w8tile,dwin:16384
INKLING_DRAFT_HOTVOCAB_FILE=/opt/inkling-overlay/inkling_draftbytes/hotvocab/inkling2-mini-hot-r2.json
INKLING_KERNELS=moe_tiles,qkvr_gemv
INKLING_MOE_TILES=1@2304:swap_ab=1,tile_n=32,tile_k=256;1@1152:swap_ab=1,tile_n=32,tile_k=256;8@2304:swap_ab=1,tile_n=32,tile_k=256;8@1152:swap_ab=1,tile_n=32,tile_k=256;64@2304:swap_ab=0,tile_n=64,tile_k=256;64@1152:swap_ab=1,tile_n=32,tile_k=256
INKLING_PICO12=dense,lmhead,stack1
INKLING_PREFILL=qkvr_split,bias_layout,quant_once,partial_bf16
INKLING_PREFILL_QKVR_OUT=strided
INKLING_CERT_HEAD=1
INKLING_WIDE=dense,lmhead
INKLING_WIDE_SCOPE=verify
INKLING_VATTN=1
INKLING_ATTN=prefill_swa,prefill_global
INKLING_PFUSE=all
INKLING_MOE2=tiles
INKLING_SCODES=1
INKLING_VERIFY_CAP_FASTPROBS=1
INKLING_VERIFY_CAP_FUSED_ACCEPT=1
INKLING_KV12=1
INKLING_KV12_MAX_PAGES=1024
