# TokenSpeed (lightseekorg): Inkling 2 Mini support is lightseekorg/tokenspeed#3682, not in a published image.
# Built by engines/tokenspeed/build.sh when missing: the PR's source on nightly-c47e7a, kernels compiled for
# sm_121a, plus sm12x-skinny-mm.patch. Serves on one Spark at these settings; slower than vLLM and SGLang there.
IMAGE=tokenspeed-inkling2mini:pr3682-52fdeee2
# 64 requests at 262K context leave a pool that "cannot admit one token"; 32 at 64K fit (424,832 tokens).
CONTEXT=65536
MAX_SEQS=32
GPU_UTIL=0.80
CHUNK=4096
KV=auto
SPEC=dspark
EXTRA_ARGS=
