# llama.cpp: a GGUF requantisation of the NVFP4 release (not the trained numerics), so it gets its own
# column in the results. Built by engines/llamacpp/build.sh when missing: the b12600 release (the Inkling 2
# Mini commit) on the server-cuda13 runtime; the published server-cuda13 image (2026-11-17) predates
# inkling2_loop. Measured best on one Spark: no speculation (DSpark cut throughput at 8 users).
IMAGE=llama-cpp-inkling2mini:b12600
GGUF_DIR=$HOME/models/gguf
GGUF=Inkling-2-Mini-IQ4_NL.gguf
SPEC=none
SLOTS=32
CTX_PER_SLOT=16384
# DSpark needs Unsloth's fork and its UD GGUF (measured slower, see docs/PLAN.md):
#   IMAGE=llama-cpp-inkling2mini:unsloth-b12588 GGUF=Inkling-2-Mini-UD-Q4_K_XL.gguf SPEC=dspark
DRAFT_GGUF=dspark-Inkling-2-Mini-Q8_0.gguf
SPEC_TOKENS=3
EXTRA_ARGS=
